---
import '../styles/global.css';
import FocusModal from '../components/shell/FocusModal.astro';

interface Props {
  title?: string;
}

const { title = 'FramigosX × GAM Esports — Power BI Financial & Unit Economics Workspace' } = Astro.props;
---

<!doctype html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="h-screen overflow-hidden flex flex-col bg-[var(--color-page)] text-[var(--color-ink)]">
    <div id="global-tooltip"></div>
    <FocusModal />
    <slot />
  </body>
</html>
