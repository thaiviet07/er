      <text x="28" y="277" font-size="10.5" fill="#1e3a8a" font-weight="500">Cơ cấu TB 3 Đợt: Shenzou 455,9k (69,5%) · Bao bì 120k (18,3%) · Logistics 80k (12,2%)</text>
    </svg>
  )}

  {visualKey === 'waterfall-compact' && (
    <svg viewBox="0 0 460 300" class="w-full h-auto svg-chart" role="img" aria-label="Thác chuyển hóa lợi nhuận 1 Hobby Box">
      <text x="16" y="22" font-size="11.5" font-weight="600" fill="#0f172a">Thác 2 Tầng &amp; Quỹ Dự phòng 5% (Trên 1 Hobby Box · TB 3 Đợt)</text>

      <line x1="20" y1="250" x2="444" y2="250" stroke="rgba(15,23,42,0.16)" stroke-width="1" />

      <!-- 1. Net Rev: 1368k -->
      <rect x="24" y="113" width="40" height="137" rx="3" fill="#1e3a8a" />
      <text x="44" y="106" text-anchor="middle" font-size="10" font-weight="600" fill="#1e3a8a">1.368k</text>
      <text x="44" y="266" text-anchor="middle" font-size="9.5" fill="#334155">Net Rev</text>

      <!-- 2. -COGS+Mkt: -693.7k -->
      <line x1="64" y1="113" x2="80" y2="113" stroke="rgba(15,23,42,0.25)" stroke-dasharray="2 2" />
      <rect x="80" y="113" width="40" height="69.5" rx="3" fill="#1e293b" />
      <text x="100" y="106" text-anchor="middle" font-size="10" font-weight="500" fill="#0f172a">−694k</text>
      <text x="100" y="266" text-anchor="middle" font-size="9.5" fill="#334155">COGS+Mkt</text>

      <!-- 3. -Royalty T1: -136.8k -->
      <line x1="120" y1="182.5" x2="136" y2="182.5" stroke="rgba(15,23,42,0.25)" stroke-dasharray="2 2" />
      <rect x="136" y="182.5" width="40" height="14" rx="2" fill="#1d4ed8" />
      <text x="156" y="175" text-anchor="middle" font-size="10" font-weight="500" fill="#1d4ed8">−136,8k</text>
      <text x="156" y="266" text-anchor="middle" font-size="9.5" fill="#334155">Roy 10%</text>

      <!-- 4. -DP 5%: -68.4k -->
      <line x1="176" y1="196.2" x2="192" y2="196.2" stroke="rgba(15,23,42,0.25)" stroke-dasharray="2 2" />
      <rect x="192" y="196.2" width="40" height="7" rx="2" fill="#64748b" />
