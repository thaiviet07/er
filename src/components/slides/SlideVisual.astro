---
import type { SlideVisualKey } from '../../data/slides';

interface Props {
  visualKey: SlideVisualKey;
}

const { visualKey } = Astro.props;
---

<div class="w-full h-full flex items-center justify-center rounded-[8px] bg-[var(--color-side)] border border-[var(--color-line)] p-4">
  {visualKey === 'exec-split' && (
    <svg viewBox="0 0 460 300" class="w-full h-auto svg-chart" role="img" aria-label="Phân bổ Doanh thu thực và ROI">
      <text x="16" y="24" font-size="11.5" font-weight="600" fill="#0f172a">Phân bổ 1.805,76 tr Doanh thu thực (3 Đợt · 1.320 Box)</text>

      <!-- 100% Stacked Net Revenue Bar -->
      <rect x="16" y="38" width="205" height="34" rx="4" fill="#1e293b" />
      <rect x="223" y="38" width="12" height="34" rx="2" fill="#64748b" />
      <rect x="237" y="38" width="43" height="34" rx="2" fill="#1d4ed8" />
      <rect x="282" y="38" width="21" height="34" rx="2" fill="#94a3b8" />
      <rect x="305" y="38" width="29" height="34" rx="2" fill="#0284c7" />
      <rect x="336" y="38" width="108" height="34" rx="4" fill="#047857" />

      <text x="118" y="59" text-anchor="middle" font-size="10.5" font-weight="500" fill="#ffffff">COGS 47,9% (865,7tr)</text>
      <text x="390" y="59" text-anchor="middle" font-size="10.5" font-weight="600" fill="#ffffff">Lãi FX 27,4%</text>

      <!-- Compact Legend -->
      <rect x="16" y="84" width="8" height="8" rx="2" fill="#1e293b" />
      <text x="28" y="92" font-size="10" fill="#334155">COGS 865,7tr</text>
      <rect x="108" y="84" width="8" height="8" rx="2" fill="#64748b" />
      <text x="120" y="92" font-size="10" fill="#334155">Mkt 50tr</text>
      <rect x="178" y="84" width="8" height="8" rx="2" fill="#1d4ed8" />
      <text x="190" y="92" font-size="10" fill="#334155">Roy 180,6tr</text>
      <rect x="262" y="84" width="8" height="8" rx="2" fill="#94a3b8" />
      <text x="274" y="92" font-size="10" fill="#334155">DP 90,3tr</text>
      <rect x="336" y="84" width="8" height="8" rx="2" fill="#0284c7" />
      <text x="348" y="92" font-size="10" fill="#334155">GAM T2 123,8tr</text>

      <!-- Divider -->
      <line x1="16" y1="112" x2="444" y2="112" stroke="rgba(15,23,42,0.08)" stroke-width="1" />
      <text x="16" y="134" font-size="11.5" font-weight="600" fill="#0f172a">So sánh Vốn đầu tư vs Lợi nhuận 2 bên (Triệu VNĐ)</text>

      <!-- Horizontal comparison bars (scale max = 600tr -> width 250px from x=130) -->
      <text x="16" y="162" font-size="11" fill="#334155">Vốn cam kết FX</text>
      <rect x="130" y="149" width="208" height="18" rx="3" fill="#0f172a" />
      <text x="346" y="162" font-size="11" font-weight="600" fill="#0f172a">500,00 tr (Mốc 100%)</text>

      <text x="16" y="194" font-size="11" font-weight="600" fill="#047857">Lãi FX An toàn</text>
      <rect x="130" y="181" width="206" height="18" rx="3" fill="#047857" />
      <text x="346" y="194" font-size="11" font-weight="600" fill="#047857">495,32 tr (+99,1% ROI)</text>

      <text x="16" y="226" font-size="11" fill="#065f46">Lãi FX Hoàn DP 80%</text>
      <rect x="130" y="213" width="236" height="18" rx="3" fill="rgba(4,120,87,0.22)" stroke="#047857" stroke-dasharray="3 2" stroke-width="1" />
      <text x="374" y="226" font-size="11" font-weight="500" fill="#047857">567,55 tr</text>

      <text x="16" y="258" font-size="11" fill="#1d4ed8">Tổng thu GAM (3 dòng)</text>
      <rect x="130" y="245" width="186" height="18" rx="3" fill="#1d4ed8" />
      <text x="324" y="258" font-size="11" font-weight="500" fill="#1d4ed8">446,97 tr (0 rủi ro tồn)</text>

      <text x="16" y="288" font-size="10.5" fill="#64748b">Lãi ròng Đợt 1 độc lập (445 Box): +107,05 tr (Biên 17,6%)</text>
    </svg>
