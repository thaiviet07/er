      <text x="16" y="22" font-size="11.5" font-weight="600" fill="#0f172a">Hành lang Định vị 1,50–2,04 tr &amp; Đơn giá / Thẻ</text>

      <!-- Axes -->
      <line x1="56" y1="242" x2="438" y2="242" stroke="rgba(15,23,42,0.18)" stroke-width="1" />
      <line x1="56" y1="42" x2="56" y2="242" stroke="rgba(15,23,42,0.18)" stroke-width="1" />

      <!-- Grid Y (0..40k) -->
      <line x1="56" y1="192" x2="438" y2="192" stroke="rgba(15,23,42,0.06)" stroke-width="1" />
      <text x="48" y="196" text-anchor="end" font-size="10" fill="#64748b">10k</text>
      <line x1="56" y1="142" x2="438" y2="142" stroke="rgba(15,23,42,0.06)" stroke-width="1" />
      <text x="48" y="146" text-anchor="end" font-size="10" fill="#64748b">20k</text>
      <line x1="56" y1="92" x2="438" y2="92" stroke="rgba(15,23,42,0.06)" stroke-width="1" />
      <text x="48" y="96" text-anchor="end" font-size="10" fill="#64748b">30k</text>
      <text x="48" y="48" text-anchor="end" font-size="10" fill="#64748b">40k</text>

      <!-- X Ticks (0..3.6M -> plotW=382) -->
      <text x="56" y="258" text-anchor="middle" font-size="10" fill="#64748b">0</text>
      <text x="162" y="258" text-anchor="middle" font-size="10" fill="#64748b">1,0 tr</text>
      <text x="268" y="258" text-anchor="middle" font-size="10" fill="#64748b">2,0 tr</text>
      <text x="374" y="258" text-anchor="middle" font-size="10" fill="#64748b">3,0 tr</text>
      <text x="247" y="276" text-anchor="middle" font-size="10.5" fill="#64748b">Giá phát hành / Hộp hoặc Pack (Zoom ≤ 3,6 tr)</text>

      <!-- Corridor 1.50M..2.04M (x = 215..272) -->
      <rect x="215" y="42" width="57" height="200" fill="rgba(29,78,216,0.07)" stroke="rgba(29,78,216,0.32)" stroke-dasharray="3 3" stroke-width="1" />
      <text x="243" y="56" text-anchor="middle" font-size="9.5" font-weight="600" fill="#1d4ed8">1,50–2,04 tr</text>

      <!-- Avg line 25.483 (y = 114.6) -->
      <line x1="56" y1="115" x2="438" y2="115" stroke="#64748b" stroke-dasharray="4 3" stroke-width="1" />
      <text x="434" y="109" text-anchor="end" font-size="9.5" fill="#334155">TB 13 SKU thuần thẻ: 25.483đ</text>

      <!-- Sample points -->
      <circle cx="67" cy="143" r="4.5" fill="rgba(15,23,42,0.4)" />
      <text x="74" y="146" font-size="9.5" fill="#334155">VBA 99k</text>

      <circle cx="137" cy="89" r="5" fill="#0284c7" />
      <text x="144" y="85" font-size="9.5" fill="#334155">Kolex Starter</text>

      <circle cx="164" cy="72" r="4.5" fill="rgba(15,23,42,0.4)" />
      <text x="171" y="75" font-size="9.5" fill="#334155">Crystal Rose</text>

      <circle cx="204" cy="117" r="4.5" fill="rgba(15,23,42,0.4)" />
      <text x="196" y="131" text-anchor="end" font-size="9.5" fill="#334155">NBA Hoops</text>

      <circle cx="326" cy="136" r="5.5" fill="#0284c7" />
      <text x="334" y="139" font-size="9.5" fill="#334155">Kolex Hobby (2,55tr)</text>

      <circle cx="351" cy="189" r="4.5" fill="rgba(15,23,42,0.4)" />
      <text x="359" y="192" font-size="9.5" fill="#334155">Riot Gift Box</text>

      <!-- Target FramigosX x GAM: 1.98M (x=266), 24.750 (y=118) -->
      <circle cx="266" cy="118" r="11" fill="rgba(29,78,216,0.16)" />
      <circle cx="266" cy="118" r="5.5" fill="#1e3a8a" stroke="#ffffff" stroke-width="1.8" />
      <rect x="276" y="152" width="146" height="22" rx="4" fill="#ffffff" stroke="rgba(29,78,216,0.38)" stroke-width="1" />
      <line x1="266" y1="123" x2="282" y2="152" stroke="#1d4ed8" stroke-width="1" />
      <text x="282" y="166" font-size="10" font-weight="600" fill="#1d4ed8">FX × GAM · 1,98tr · 24.750đ</text>

      <text x="16" y="292" font-size="9.5" fill="#64748b">Topps Chrome Hobby (7,15 tr · 89.375đ/thẻ) nằm ngoài khung Zoom để giữ độ phân giải.</text>
    </svg>
  )}

  {visualKey === 'sku-staircase' && (
    <svg viewBox="0 0 460 300" class="w-full h-auto svg-chart" role="img" aria-label="Bậc thang đơn giá 4 SKU">
      <text x="16" y="24" font-size="11.5" font-weight="600" fill="#0f172a">Đơn giá / Thẻ (Gồm VAT) qua 4 bậc SKU</text>

      <!-- Anchor vertical line at 24.750 -->
      <line x1="318.5" y1="42" x2="318.5" y2="232" stroke="#0f172a" stroke-dasharray="3 3" stroke-width="1.2" />
      <text x="318.5" y="246" text-anchor="middle" font-size="9.5" font-weight="600" fill="#0f172a">Mốc chuẩn: 24.750đ/thẻ</text>

      <!-- Row 1: Single Pack -->
      <text x="16" y="64" font-size="11" font-weight="500" fill="#0f172a">SKU 1 · Single Pack</text>
      <text x="16" y="78" font-size="9.5" fill="#64748b">209.000đ (8 thẻ)</text>
      <rect x="155" y="54" width="185" height="22" rx="4" fill="rgba(15,23,42,0.06)" />
      <rect x="155" y="54" width="173" height="22" rx="4" fill="#334155" />
      <text x="336" y="69" font-size="10.5" font-weight="600" fill="#0f172a" paint-order="stroke" stroke="#f8fafc" stroke-width="4">26.125đ (+5,6%)</text>

      <!-- Row 2: Hobby Box -->
      <text x="16" y="114" font-size="11" font-weight="600" fill="#1d4ed8">SKU 3 · Hobby Box</text>
      <text x="16" y="128" font-size="9.5" fill="#1d4ed8">1.980.000đ (80 thẻ)</text>
      <rect x="155" y="104" width="185" height="22" rx="4" fill="rgba(15,23,42,0.06)" />
      <rect x="155" y="104" width="163.5" height="22" rx="4" fill="#1d4ed8" />
      <text x="326" y="119" font-size="10.5" font-weight="600" fill="#1d4ed8" paint-order="stroke" stroke="#f8fafc" stroke-width="4">24.750đ (Mốc 0%)</text>

      <!-- Row 3: Master Case -->
      <text x="16" y="164" font-size="11" font-weight="500" fill="#0f172a">SKU 4 · Master Case</text>
      <text x="16" y="178" font-size="9.5" fill="#64748b">18.810.000đ (800 thẻ)</text>
      <rect x="155" y="154" width="185" height="22" rx="4" fill="rgba(15,23,42,0.06)" />
      <rect x="155" y="154" width="155" height="22" rx="4" fill="#047857" />
      <text x="318" y="169" font-size="10.5" font-weight="600" fill="#047857" paint-order="stroke" stroke="#f8fafc" stroke-width="4">23.513đ (−5,0%)</text>

      <!-- Row 4: Early-Bird -->
      <text x="16" y="214" font-size="11" font-weight="500" fill="#0f172a">SKU 2 · Early-Bird Box</text>
      <text x="16" y="228" font-size="9.5" fill="#64748b">1.782.000đ (80 thẻ)</text>
      <rect x="155" y="204" width="185" height="22" rx="4" fill="rgba(15,23,42,0.06)" />
      <rect x="155" y="204" width="147" height="22" rx="4" fill="#0284c7" />
      <text x="310" y="219" font-size="10.5" font-weight="600" fill="#0284c7" paint-order="stroke" stroke="#f8fafc" stroke-width="4">22.275đ (−10,0%)</text>

      <rect x="16" y="260" width="428" height="28" rx="5" fill="#ffffff" stroke="rgba(15,23,42,0.09)" stroke-width="1" />
      <text x="28" y="278" font-size="10.5" fill="#334155">Biên độ giãn cách hợp lý (22,3k–26,1k/thẻ) chống xung đột kênh Retail vs Pre-order.</text>
    </svg>
  )}

  {visualKey === 'channel-margin' && (
    <svg viewBox="0 0 460 300" class="w-full h-auto svg-chart" role="img" aria-label="Hiệu quả ròng qua 3 kênh phân phối">
      <text x="16" y="24" font-size="11.5" font-weight="600" fill="#0f172a">Doanh thu thực &amp; Lãi ròng FX trên mỗi Hobby Box (VNĐ)</text>

      <!-- Legend -->
      <rect x="16" y="34" width="9" height="9" rx="2" fill="rgba(15,23,42,0.20)" />
      <text x="29" y="42" font-size="10" fill="#334155">Doanh thu thực (Net Rev)</text>
      <rect x="172" y="34" width="9" height="9" rx="2" fill="#047857" />
      <text x="185" y="42" font-size="10" fill="#334155">Lãi ròng An toàn FX (TB 3 Đợt)</text>

      <!-- 1. TCG -->
      <text x="16" y="76" font-size="11" font-weight="500" fill="#0f172a">1. Đại lý TCG (55%)</text>
      <text x="16" y="90" font-size="9.5" fill="#64748b">CK BQ 30,0%</text>
      <rect x="138" y="64" width="167" height="11" rx="2" fill="rgba(15,23,42,0.20)" />
      <text x="311" y="73" font-size="10" fill="#334155">1.260.000đ</text>
      <rect x="138" y="78" width="40" height="11" rx="2" fill="#1e293b" />
      <text x="184" y="87" font-size="10.5" font-weight="600" fill="#1e293b">301.801đ (24,0%)</text>

      <!-- 2. GAM Store -->
      <text x="16" y="130" font-size="11" font-weight="500" fill="#1d4ed8">2. GAM Store (30%)</text>
      <text x="16" y="144" font-size="9.5" fill="#64748b">Hoa hồng 20,0%</text>
      <rect x="138" y="118" width="191" height="11" rx="2" fill="rgba(15,23,42,0.20)" />
      <text x="335" y="127" font-size="10" fill="#334155">1.440.000đ</text>
      <rect x="138" y="132" width="56" height="11" rx="2" fill="#1d4ed8" />
      <text x="200" y="141" font-size="10.5" font-weight="600" fill="#1d4ed8">424.201đ (29,5%)</text>

      <!-- 3. D2C -->
      <text x="16" y="184" font-size="11" font-weight="500" fill="#047857">3. FramigosX D2C (15%)</text>
      <text x="16" y="198" font-size="9.5" fill="#64748b">Early-Bird &amp; sàn 10%</text>
      <rect x="138" y="172" width="215" height="11" rx="2" fill="rgba(15,23,42,0.20)" />
      <text x="359" y="181" font-size="10" fill="#334155">1.620.000đ</text>
      <rect x="138" y="186" width="73" height="11" rx="2" fill="#047857" />
      <text x="217" y="195" font-size="10.5" font-weight="600" fill="#047857">546.601đ (33,7%)</text>

      <!-- Blended -->
      <rect x="12" y="214" width="436" height="40" rx="6" fill="rgba(4,120,87,0.07)" stroke="rgba(4,120,87,0.24)" stroke-width="1" />
      <text x="22" y="232" font-size="11" font-weight="600" fill="#0f172a">Bình quân (55/30/15)</text>
      <text x="22" y="246" font-size="9.5" fill="#334155">76,0% SRP trước VAT</text>
      <text x="180" y="232" font-size="10.5" fill="#334155">Net: <tspan font-weight="600" fill="#0f172a">1.368.000đ</tspan></text>
      <text x="180" y="246" font-size="10.5" fill="#047857" font-weight="600">Lãi FX: 375.241đ/Box (27,4%)</text>

      <text x="16" y="280" font-size="10" fill="#64748b">Sỉ đứt đoạn 3 hạng: Silver 26% (lãi ĐL 468k) · Gold 30% (540k) · Platinum 34% (612k).</text>
    </svg>
  )}

  {visualKey === 'cogs-scale' && (
    <svg viewBox="0 0 460 300" class="w-full h-auto svg-chart" role="img" aria-label="Tiết kiệm giá vốn quy mô 3 đợt">
      <text x="16" y="24" font-size="11.5" font-weight="600" fill="#0f172a">Giảm Giá vốn Landed COGS: Đợt 1 (445b) vs TB 3 Đợt (1.320b)</text>

      <!-- Total COGS comparison -->
      <rect x="16" y="42" width="428" height="72" rx="6" fill="#ffffff" stroke="rgba(15,23,42,0.09)" stroke-width="1" />
      <text x="28" y="63" font-size="11" fill="#334155">Đợt 1 độc lập</text>
      <rect x="128" y="52" width="230" height="14" rx="3" fill="rgba(15,23,42,0.24)" />
      <text x="366" y="63" font-size="11" font-weight="500" fill="#0f172a">794.694đ/Box</text>

      <text x="28" y="92" font-size="11" font-weight="600" fill="#047857">TB 3 Đợt</text>
      <rect x="128" y="81" width="190" height="14" rx="3" fill="#047857" />
      <text x="326" y="92" font-size="11" font-weight="600" fill="#047857">655.870đ (−17,5%)</text>

      <text x="16" y="138" font-size="11" font-weight="600" fill="#0f172a">Top 3 hạng mục hưởng lợi quy mô lớn nhất</text>

      <!-- A6 -->
      <text x="16" y="164" font-size="10.5" font-weight="500" fill="#0f172a">A6. Phôi Jersey Relic</text>
      <rect x="150" y="152" width="150" height="6.5" rx="2" fill="rgba(15,23,42,0.22)" />
      <rect x="150" y="161" width="51" height="6.5" rx="2" fill="#047857" />
      <text x="308" y="164" font-size="10.5" font-weight="600" fill="#047857">114,6k → 38,6k (−66,3%)</text>

      <!-- A1 -->
      <text x="16" y="200" font-size="10.5" font-weight="500" fill="#0f172a">A1. Làm mẫu R&amp;D</text>
      <rect x="150" y="188" width="75" height="6.5" rx="2" fill="rgba(15,23,42,0.22)" />
      <rect x="150" y="197" width="25" height="6.5" rx="2" fill="#047857" />
      <text x="234" y="200" font-size="10.5" font-weight="600" fill="#047857">57,3k → 19,3k (−66,3%)</text>

      <!-- A8 -->
      <text x="16" y="236" font-size="10.5" font-weight="500" fill="#0f172a">A8. Màng nhôm Pack</text>
      <rect x="150" y="224" width="75" height="6.5" rx="2" fill="rgba(15,23,42,0.22)" />
      <rect x="150" y="233" width="38" height="6.5" rx="2" fill="#047857" />
      <text x="234" y="236" font-size="10.5" font-weight="600" fill="#047857">57,3k → 29,0k (−49,4%)</text>

      <!-- Bottom summary -->
